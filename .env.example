# ─────────────────────────────────────────────────────────────────────────────
# Montefiore PDF/UA Remediation Suite — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your API keys.
# ─────────────────────────────────────────────────────────────────────────────


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# OpenClaw gateway token — used to authenticate the web UI and API.
# Set this to any strong random string. Keep it secret.
# Generate one with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Your API key for the primary model provider.
PRIMARY_PROVIDER_API_KEY=


# ─── WORKSPACE ───────────────────────────────────────────────────────────────
# Absolute path to your workspace directory on your HOST machine.
# This is mounted into the container — PDFs and job data live here, not in Docker.
# The directory is created on first run if it doesn't exist.
#
# Examples:
#   macOS/Linux: WORKSPACE_PATH=/Users/yourname/montefiore-workspace
#   Windows:     WORKSPACE_PATH=C:/Users/yourname/montefiore-workspace

WORKSPACE_PATH=/Users/yourname/montefiore-workspace


# ─── PRIMARY MODEL ───────────────────────────────────────────────────────────
# Handles all audit, repair, and packaging decisions.
# Must support: tool calling, JSON mode, 32K+ context window.
#
# Provider must expose an OpenAI-compatible API endpoint
# (POST /v1/chat/completions). Examples below.

PRIMARY_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_MODEL=stepfun-ai/step-3.5-flash


# ─── VISION MODEL ────────────────────────────────────────────────────────────
# Used for visual page comparison, alt text draft generation, and document
# content classification. Must support image/vision input.
#
# If your primary provider handles vision too (OpenAI, Anthropic, OpenRouter),
# leave VISION_PROVIDER_BASE_URL and VISION_PROVIDER_API_KEY blank — they will
# fall back to the primary credentials automatically. Set VISION_MODEL to the
# vision-capable model your provider offers.

VISION_PROVIDER_BASE_URL=
VISION_PROVIDER_API_KEY=
VISION_MODEL=meta/llama-3.2-11b-vision-instruct


# ─── TOOL PATHS ──────────────────────────────────────────────────────────────
# Set automatically inside Docker. Only change if running outside the container.

VERAPDF_BIN=/opt/verapdf-greenfield/verapdf
QPDF_BIN=/usr/bin/qpdf


# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER EXAMPLES — uncomment and adjust the block matching your provider.
# All blocks below are OpenAI-compatible endpoints.
# ─────────────────────────────────────────────────────────────────────────────


# ─── NVIDIA NIM ──────────────────────────────────────────────────────────────
# Single API key, access to 100+ models including text and vision.
# Get a key at: https://build.nvidia.com/settings/api-keys
#
# PRIMARY_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
# PRIMARY_PROVIDER_API_KEY=nvapi-your-key-here
# PRIMARY_MODEL=stepfun-ai/step-3.5-flash
# VISION_PROVIDER_BASE_URL=
# VISION_PROVIDER_API_KEY=
# VISION_MODEL=meta/llama-3.2-11b-vision-instruct


# ─── OpenAI ──────────────────────────────────────────────────────────────────
# One model handles both text reasoning and vision.
# Get a key at: https://platform.openai.com/api-keys
#
# PRIMARY_PROVIDER_BASE_URL=https://api.openai.com/v1
# PRIMARY_PROVIDER_API_KEY=sk-your-key-here
# PRIMARY_MODEL=gpt-4.1
# VISION_PROVIDER_BASE_URL=
# VISION_PROVIDER_API_KEY=
# VISION_MODEL=gpt-4.1


# ─── Anthropic ───────────────────────────────────────────────────────────────
# One model handles both text reasoning and vision.
# Get a key at: https://console.anthropic.com/settings/keys
#
# PRIMARY_PROVIDER_BASE_URL=https://api.anthropic.com/v1
# PRIMARY_PROVIDER_API_KEY=sk-ant-your-key-here
# PRIMARY_MODEL=claude-sonnet-4-5
# VISION_PROVIDER_BASE_URL=
# VISION_PROVIDER_API_KEY=
# VISION_MODEL=claude-sonnet-4-5


# ─── OpenRouter ──────────────────────────────────────────────────────────────
# Aggregator — access many providers with one key.
# Get a key at: https://openrouter.ai/settings/keys
#
# PRIMARY_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# PRIMARY_PROVIDER_API_KEY=sk-or-your-key-here
# PRIMARY_MODEL=stepfun/step-3.5-flash
# VISION_PROVIDER_BASE_URL=
# VISION_PROVIDER_API_KEY=
# VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct


# ─── Local Ollama ────────────────────────────────────────────────────────────
# No API cost, runs on your machine. Requires a GPU with sufficient VRAM.
# Install: https://ollama.ai
# Pull models: ollama pull qwen3:32b && ollama pull qwen2.5vl:7b
#
# PRIMARY_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
# PRIMARY_PROVIDER_API_KEY=ollama
# PRIMARY_MODEL=qwen3:32b
# VISION_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
# VISION_PROVIDER_API_KEY=ollama
# VISION_MODEL=qwen2.5vl:7b


# ─────────────────────────────────────────────────────────────────────────────
# NOTES
#
# - When using a provider where one model handles both text and vision,
#   leave VISION_PROVIDER_BASE_URL and VISION_PROVIDER_API_KEY blank and
#   set VISION_MODEL to the same model as PRIMARY_MODEL.
#
# - Model ID strings are provider-specific. A NIM model ID like
#   "meta/llama-3.2-11b-vision-instruct" differs from the OpenRouter
#   version "meta-llama/llama-3.2-11b-vision-instruct".
#
# - To switch providers, edit the values above and restart the container:
#     docker compose restart
#   Then verify:
#     docker compose exec montefiore-remediation env | grep -E 'MODEL|PROVIDER'
#
# - To delete the example file after creating your .env, run:
#     rm .env.example
# ─────────────────────────────────────────────────────────────────────────────
