{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "auto",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/app/workspace",
      "model": {
        "primary": "nim/${PRIMARY_MODEL}",
        "fallbacks": []
      },
      "models": {
        "nim/${PRIMARY_MODEL}": { "alias": "primary" },
        "nim/${VISION_MODEL}": { "alias": "vision" }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "nim": {
        "baseUrl": "${PRIMARY_PROVIDER_BASE_URL}",
        "apiKey": "${PRIMARY_PROVIDER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${PRIMARY_MODEL}",
            "name": "Step 3.5 Flash",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 256000,
            "maxTokens": 8192
          },
          {
            "id": "${VISION_MODEL}",
            "name": "Nemotron Vision",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 131072,
            "maxTokens": 4096
          }
        ]
      }
    }
  }
}
