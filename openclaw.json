{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "auto",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/app",
      "model": {
        "primary": "nim/${PRIMARY_MODEL}",
        "fallbacks": []
      },
      "models": {
        "nim/${PRIMARY_MODEL}": {
          "alias": "primary"
        },
        "nim/${VISION_MODEL}": {
          "alias": "vision"
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "nim": {
        "baseUrl": "${PRIMARY_PROVIDER_BASE_URL}",
        "apiKey": "${PRIMARY_PROVIDER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${PRIMARY_MODEL}",
            "input": ["text"]
          },
          {
            "id": "${VISION_MODEL}",
            "input": ["text", "image"]
          }
        ]
      }
    }
  }
}
